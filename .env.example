# Example environment configuration for Football Prediction
# Copy this file to .env and replace placeholders with real values

# Signing secret for JWT/session tokens (keep secret)
JWT_SECRET=YOUR_JWT_SECRET

# Secret to protect cron / scheduled endpoints
CRON_SECRET=YOUR_CRON_SECRET

# Token used to fetch live match data from the configured API
FIFA_API_TOKEN=YOUR_FIFA_API_TOKEN

# VAPID keys for Web Push (public key is exposed to clients)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Typical runtime/env flags
NODE_ENV=development
NEXT_RUNTIME=nodejs

# Optional: Next.js server actions encryption key (if used by your hosting setup)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=YOUR_NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
